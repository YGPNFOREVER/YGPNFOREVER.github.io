&lt;/h1&gt;&lt;p&gt;&lt;img src=&#34;https://YGPNFOREVER.github.io/p/%E6%95%85%E4%BA%8B%E5%BC%80%E5%A7%8B%E5%9C%A8%E6%9C%80%E5%88%9D%E7%9A%84%E9%82%A3%E4%B8%AA%E6%A2%A6%E4%B8%AD.-.-./image.png&#34;
